# ./setup.sh writes this file for you as config.env. To do it by hand: copy to config.env and
# fill in. setup.sh, deploy.sh, bootstrap.sh, install.sh and mac/setup-mac.sh read it.
# More than one server: one file each, e.g. config.ai.env, picked with CONFIG=config.ai.env
# in front of any command (see README, "More than one server").
# Nothing in here is secret; passwords and API keys never go in this repo.

# Your user on the server and how your computer reaches it (mDNS name, LAN IP or Tailscale name).
SERVER_USER=me
SERVER_HOST=homelab.local

# Short name for the box: landing page title, <NAME>.local, backup folder and key names.
NAME=homelab

# Which services to run (see stacks/*/module.env): pihole hermes n8n uptime-kuma beszel, and ai
# on a box with an NVIDIA GPU (not part of the default).
# Caddy, the firewall, Tailscale and backups are always on. Without pihole, the services get
# a port on the server (<NAME>.local:8001 ...) instead of a <service>.<DOMAIN> name.
# After changing it, run ./setup.sh (or bootstrap.sh, then ./deploy.sh): the firewall follows it.
MODULES="pihole hermes n8n uptime-kuma beszel"

# The server's LAN IPv4. Reserve it in your router so it never changes. Empty: detected.
LAN_IP=192.168.1.10

# The server's Tailscale IPv4. Empty: detected (`tailscale ip -4`).
TAILSCALE_IP=

# Who may reach DNS and the web UIs besides Tailscale devices. Add your IPv6 /64 if you have one.
TRUSTED_NETS="192.168.1.0/24 fe80::/10"

TZ=Europe/Berlin

# With Pi-hole, services become pihole.<DOMAIN>, n8n.<DOMAIN>, ... home.arpa is reserved for
# home networks.
DOMAIN=home.arpa

# Nightly backup time, in TZ.
BACKUP_TIME=04:00

# Optional: lower the CPU fan's minimum speed on boards with an ITE IT87xx chip (0-255).
# Leave empty to skip. See extras/it87-fan/README.md before using it.
IT87_FAN_MIN_PWM=

# Optional: announce <NAME>.local only on these interfaces (e.g. "enp38s0"). Needed when the box
# has Ethernet and Wi-Fi on the same network: Avahi then sees its own name on the other one and
# renames itself to <NAME>-2.local. Empty: all interfaces.
MDNS_INTERFACES=

# Optional, with the hermes module: devices Hermes may wake by Wake-on-LAN, as "name=mac ..."
# (e.g. "gpubox=aa:bb:cc:dd:ee:ff"). It asks the host, which sends the packet; see the
# wake-device skill it gets. Empty: Hermes can't wake anything.
WAKE_TARGETS=

# Optional: wake the box over the network (Ethernet only, e.g. enp38s0), from suspend and, if
# the BIOS allows it, from off. The MAC is that port's, for ./ai-model.sh wake; VIA is an
# always-on box on the same network to send the packet from when you're away (e.g.
# me@homelab.local). See extras/wake-on-lan/README.md.
WAKE_ON_LAN_IFACE=
WAKE_ON_LAN_MAC=
WAKE_ON_LAN_VIA=

# Optional: reconnect Wi-Fi when it stays connected but stops passing traffic (e.g. wlp6s0).
# Leave empty to skip; not needed on ethernet. See extras/wifi-watchdog/README.md.
WIFI_WATCHDOG_IFACE=

# The ai module (stacks/ai/README.md). What gets the GPU on a new box: qwen27b (Qwen3.8-27B
# on llama.cpp), strata (Qwen3.8-Flash-Next on Strata) or swarmui (image generation). Later,
# switch on the Local AI page or with ./ai-model.sh; that choice wins over this one.
AI_MODEL=qwen27b
# Where the models go (~85 GB for both), and optionally the partition to mount there, e.g.
# /dev/nvme0n1p1. bootstrap.sh adds it to /etc/fstab; it never formats anything.
AI_MODELS_DIR=/srv/models
AI_MODELS_DEVICE=
# Context window in tokens for Qwen3.8-27B (all on the GPU, so 32K on 16 GB) and for Strata
# (KV cache in RAM: 128K is setup's pick for IQ3_S on 64 GB; agents like Hermes need 64K+, their
# tools alone take ~28K), and the quantizations (file sizes in stacks/ai/README.md).
AI_CONTEXT=32768
AI_STRATA_CONTEXT=131072
AI_QWEN27B_QUANT=UD-Q3_K_XL
AI_STRATA_QUANT=IQ3_S
# yes: an on/off switch for the case's RGB LEDs on the Local AI page, through OpenRGB (anything
# plugged into the board's RGB headers, plus devices OpenRGB supports). "On" sets this mode on
# each device (see `sudo openrgb --list-devices` for the names), at this speed: 0 (slowest) to
# 100; empty keeps the device's default. Boards with few speed steps round it.
AI_LEDS=
AI_LEDS_ON_MODE="Rainbow wave"
AI_LEDS_ON_SPEED=
