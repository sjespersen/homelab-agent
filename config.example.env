# Copy to config.env and fill in. deploy.sh, bootstrap.sh, install.sh and mac/setup-mac.sh read it.
# Nothing in here is secret; passwords and API keys never go in this repo.

# Your user on the server and how your computer reaches it (mDNS name, LAN IP or Tailscale name).
SERVER_USER=me
SERVER_HOST=homelab.local

# Short name for the box: landing page title, <NAME>.home.arpa, backup folder and key names.
NAME=homelab

# The server's LAN IPv4. Reserve it in your router so it never changes.
LAN_IP=192.168.1.10

# The server's Tailscale IPv4 (`tailscale ip -4`). Leave empty until bootstrap.sh has run,
# then fill it in and run ./deploy.sh again.
TAILSCALE_IP=

# Who may reach DNS and the web UIs besides Tailscale devices. Add your IPv6 /64 if you have one.
TRUSTED_NETS="192.168.1.0/24 fe80::/10"

TZ=Europe/Berlin

# Service names become pihole.<DOMAIN>, n8n.<DOMAIN>, ... home.arpa is reserved for home networks.
DOMAIN=home.arpa

# Nightly backup time, in TZ.
BACKUP_TIME=04:00

# Optional: lower the CPU fan's minimum speed on boards with an ITE IT87xx chip (0-255).
# Leave empty to skip. See extras/it87-fan/README.md before using it.
IT87_FAN_MIN_PWM=
