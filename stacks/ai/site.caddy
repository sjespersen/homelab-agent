# The switcher: its page, and the chat models' API (/v1), which it passes to the model a
# request names (starting it first). Long answers stream; no timeout cuts them off.
# /ollama (Ollama's own API, no login) is only for Open WebUI on the stack's network.
handle /ollama* {
	respond "not found" 404
}
handle {
	reverse_proxy 127.0.0.1:8079
}
