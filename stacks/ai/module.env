# Local AI: chat models and image generation taking turns on an NVIDIA GPU, a page to switch
# between them, and an OpenAI-compatible API. Needs an NVIDIA card (12 GB+) and a disk with
# room for the models, so it's not in the default MODULES. See stacks/ai/README.md.
TITLE="Local AI"
DESCRIPTION="switch models, OpenAI-compatible API"
ORDER=25
OPT_IN=yes
HOST=ai
PORT=8005
# SwarmUI on its own address (it needs the whole site): site.swarm.caddy.
SITES=swarm
SITE_swarm_HOST=swarm
SITE_swarm_PORT=8006
SITE_swarm_TITLE=SwarmUI
SITE_swarm_DESCRIPTION="image generation (ComfyUI)"

# Defaults for the AI_* settings in config.env (see config.example.env).
AI_MODEL=${AI_MODEL:-qwen27b}
AI_MODELS_DIR=${AI_MODELS_DIR:-/srv/models}
AI_CONTEXT=${AI_CONTEXT:-32768}
AI_QWEN27B_QUANT=${AI_QWEN27B_QUANT:-UD-Q3_K_XL}
AI_STRATA_QUANT=${AI_STRATA_QUANT:-IQ3_S}
AI_STRATA_CONTEXT=${AI_STRATA_CONTEXT:-131072}
AI_LEDS=${AI_LEDS:-}
AI_LEDS_ON_MODE=${AI_LEDS_ON_MODE:-Rainbow wave}
AI_LEDS_ON_SPEED=${AI_LEDS_ON_SPEED:-}
# What compose starts: AI_MODEL, unless the switcher picked another (before-up.sh).
COMPOSE_PROFILES=$AI_MODEL
ENV="COMPOSE_PROFILES AI_MODELS_DIR AI_CONTEXT AI_QWEN27B_QUANT AI_STRATA_QUANT AI_STRATA_CONTEXT AI_LEDS AI_LEDS_ON_MODE AI_LEDS_ON_SPEED"
