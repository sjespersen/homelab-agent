# Hermes Agent: the AI agent. Chat with it on Telegram/WhatsApp, let it code and push to GitHub.
TITLE=Hermes
DESCRIPTION="AI agent dashboard"
ORDER=20
HOST=hermes
PORT=8001
# OpenAI-compatible API and the dashboard/Hermes Desktop backend, published by Docker.
FIREWALL_PORTS="8642 9119"
# Copied while Hermes runs instead of stopping it every night (homelab-backup.sh).
BACKUP_SQLITE="data/*.db data/cron/*.db"
# Devices Hermes may wake by Wake-on-LAN (after-up.sh): "name=mac ..." from the config.
WAKE_TARGETS=${WAKE_TARGETS:-}
ENV="WAKE_TARGETS"
